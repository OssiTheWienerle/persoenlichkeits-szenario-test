# No provider is connected by default. Keep the Google key server-side only.
REPORT_ENABLED=false
REPORT_PROVIDER=gemini
REPORT_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
REPORT_API_KEY=
REPORT_PROVIDER_LABEL=Google Gemini (Google AI Studio)
REPORT_QUOTA_SECRET=
# Render's single-instance in-memory limiter: 3 reports per visitor/hour, 100/day total.
REPORT_QUOTA_MODE=memory
# Gemini API response text is read from candidates[0].content.parts[].text.
# REPORT_LOCAL_MOCK=true is only for isolated localhost tests.
